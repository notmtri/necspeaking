# Backend
SECRET_KEY=replace-with-a-long-random-value
PRODUCTION=false
SESSION_COOKIE_NAME=necs_session
SESSION_COOKIE_DOMAIN=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
DATABASE_URL=sqlite:///necs.db
CREATE_TABLES_ON_START=
REDIS_URL=
ENABLE_EMBEDDED_WORKER=
ANALYSIS_JOB_RETENTION_HOURS=72
# A job still 'processing' after this long belongs to a worker that died
# (restart, free-tier spin-down). It is marked failed so the student is told.
ANALYSIS_JOB_STALE_MINUTES=20

# Admin auth
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=
ADMIN_DEV_PASSWORD=admin-dev-password

# AI services
# Only the Gemini path sends the recording. The Groq fallback grades from the
# transcript alone, so Delivery is scored without hearing the audio. Confirm
# GEMINI_GRADING_MODEL names a model your key can actually reach, then check
# result.grader on a finished job: a permanent "groq-fallback" means the Gemini
# call is failing.
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GEMINI_GRADING_MODEL=gemini-3.5-flash
# Tried in order when the primary returns 503 "high demand" or times out.
# Flash models saturate for minutes at a time but rarely all at once.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GROQ_GRADING_FALLBACK_MODEL=openai/gpt-oss-120b
# Flash models return 503 under load. Without retries a momentary spike
# silently downgrades a student to transcript-only grading. Applies per model.
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_BACKOFF_SECONDS=1.5
# A model that times out is skipped rather than retried.
GEMINI_REQUEST_TIMEOUT_SECONDS=120

# Proxies in front of the app that append to X-Forwarded-For. Rate limiting
# keys on the address that many hops from the right. Render + Cloudflare is 3
# (the production default); 0 locally means "use the socket address".
TRUSTED_PROXY_HOPS=
# Optional override. Production defaults to None because the API is on a
# different site from the app; serve it from api.<your-domain> and use Lax.
SESSION_COOKIE_SAMESITE=

# Sample uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend
VITE_API_URL=http://127.0.0.1:5000
