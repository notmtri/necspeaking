# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Node
node_modules/
# Windows can hold a lock on native .node binaries, so a reinstall may leave
# a renamed copy behind. Never commit one.
node_modules.*/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.*
!.env.example
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Build output
build/
dist/
frontend/build/

# Databases and local runtime state
*.db
*.sqlite
*.sqlite3
backend/instance/

# Uploads and generated files
uploads/
backend/uploads/*.wav
backend/uploads/*.mp3
backend/uploads/*.m4a
backend/uploads/*.webm
backend/uploads/*.ogg
backend/uploads/*.docx
backend/uploads/*.tmp
# Runtime analysis-job scratch space.
backend/uploads/jobs/

# Keep curated bundled sample fixtures if intentionally committed.
!backend/uploads/
!backend/uploads/questions.json
!backend/uploads/samples/
!backend/uploads/samples/metadata.json
!backend/uploads/samples/*.mp3
!backend/uploads/samples/*.m4a

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Vercel local metadata
.vercel/
